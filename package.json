{
  "name": "weather",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "npm run build && wrangler dev",
    "audit:age": "node scripts/check-package-age.mjs",
    "preinstall": "node scripts/check-package-age.mjs --preinstall 2>/dev/null || true",
    "deps:update": "echo '⚠️  Run: npm outdated, review versions, update package.json, then run npm run audit:age before npm install'",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.2",
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "wrangler": "4.100.0"
  },
  "dependencies": {
    "@types/leaflet": "1.9.21",
    "leaflet": "1.9.4",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "5.0.0"
  },
  "overrides": {
    "enhanced-resolve": "5.22.0",
    "tinyglobby": "0.2.16"
  }
}
